{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": [
    "commitments/**/*.ts",
    "cubic/**/*.ts",
    "eddsa/**/*.ts",
    "merkle_proof/**/*.ts",
    "mimc/**/*.ts"
  ]
}
